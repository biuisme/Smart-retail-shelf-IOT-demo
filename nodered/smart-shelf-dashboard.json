    {
        "id": "f10000000000000b",
        "type": "function",
        "z": "f100000000000001",
        "name": "Chuẩn hoá telemetry",
        "func": "// msg.payload đã được node MQTT parse từ JSON\nconst d = msg.payload || {};\n\n// Bỏ qua dữ liệu của thiết bị khác\nif (d.device_id && d.device_id !== 'shelf_01') {\n    return null;\n}\n\nconst weight = Number(d.weight_g);\nconst qty = Number(d.quantity);\nconst alert = String(d.alert_status || 'UNKNOWN');\n\nif (!isFinite(weight) || !isFinite(qty)) {\n    return null;\n}\n\nlet alertText = 'BÌNH THƯỜNG';\nif (alert === 'LOW_STOCK') {\n    alertText = 'TỒN KHO THẤP';\n} else if (alert === 'ERR:OBJECT') {\n    alertText = 'SAI KHỐI LƯỢNG';\n}\n\nconst timeText = new Date().toLocaleTimeString('vi-VN', { hour12: false });\n\nreturn [\n    { payload: weight },\n    { payload: qty },\n    { payload: qty + ' sản phẩm · ' + alertText + ' · ' + timeText },\n    { payload: weight, topic: d.device_id || 'shelf_01' }\n];\n",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 120,
        "wires": [
            [
                "f10000000000000d"
            ],
            [
                "f10000000000000e"
            ],
            [
                "f10000000000000f"
            ],
            [
                "f100000000000010"
            ]
        ]
    },
    {
        "id": "f10000000000000c",
        "type": "function",
        "z": "f100000000000001",
        "name": "Chuẩn hoá status",
        "func": "const d = msg.payload || {};\nconst online = (d.connection === 'ONLINE');\nmsg.payload = online ? 'ONLINE' : 'OFFLINE';\nmsg.bg = online ? '#2e7d32' : '#c62828';\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
